# Copy to .env and fill in what you need. Never commit .env.
# Everything is optional. With no settings, LogOps runs fully offline against the simulator.

# simulator | splunk
LOGOPS_MODE=simulator
LOGOPS_SIM_SCENARIO=legacy_demo
LOGOPS_DB_PATH=logops.db
LOGOPS_REQUEST_TIMEOUT_S=30

# Official Splunk MCP Server (Phase 9, experimental). Use a token with read-only roles.
# LOGOPS_SPLUNK_MCP_URL=https://your-instance.splunkcloud.com:8089/services/mcp
# LOGOPS_SPLUNK_TOKEN=
# LOGOPS_SPLUNK_VERIFY_TLS=true

# AI explanations (optional). Groq is tried first, then Gemini.
# LOGOPS_AI_ENABLED=true
# LOGOPS_GROQ_API_KEY=
# LOGOPS_GROQ_MODEL=llama-3.3-70b-versatile
# LOGOPS_GEMINI_API_KEY=
# LOGOPS_GEMINI_MODEL=gemini-2.5-flash

# Optional: push synthetic events to a Splunk HTTP Event Collector
# LOGOPS_HEC_URL=https://your-instance.splunkcloud.com:8088/services/collector/event
# LOGOPS_HEC_TOKEN=
